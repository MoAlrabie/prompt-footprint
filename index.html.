<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Prompt Footprint</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style>
/* Layout: instrument-panel calculator. Inputs on the left, readings on the right, method notes below. */
:root{
  --bg:#f3f5f4; --surface:#ffffff; --line:#d5dcd9; --fg:#18211f; --muted:#5b6865;
  --carbon:#3d4744; --leaf:#2f7a4b; --water:#1f6fa8; --accent:#2f7a4b; --tint:#e7eeeb;
  --display:"Bricolage Grotesque", "Segoe UI", system-ui, sans-serif;
  --body:"IBM Plex Sans", "Segoe UI", system-ui, sans-serif;
  --mono:"IBM Plex Mono", ui-monospace, Menlo, Consolas, monospace;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#111715; --surface:#18201e; --line:#2b3633; --fg:#e6ecea; --muted:#9aa8a4;
  --carbon:#b9c4c0; --leaf:#5fbf83; --water:#5aa9e0; --accent:#5fbf83; --tint:#1e2926; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#111715; --surface:#18201e; --line:#2b3633; --fg:#e6ecea; --muted:#9aa8a4;
  --carbon:#b9c4c0; --leaf:#5fbf83; --water:#5aa9e0; --accent:#5fbf83; --tint:#1e2926; color-scheme:dark}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--fg);font-family:var(--body);font-size:15px;line-height:1.5}
.wrap{max-width:1180px;margin:0 auto;padding-block:32px 56px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
h1,h2,h3{font-family:var(--display);text-wrap:balance;margin:0;font-weight:700}
h1{font-size:clamp(2rem,4.5vw,3.1rem);line-height:1.05;letter-spacing:-.02em}
h2{font-size:1.25rem}
h3{font-size:1rem;font-weight:500}
.lede{max-width:64ch;color:var(--muted);margin:12px 0 0}
.eyebrow{font-family:var(--mono);font-size:.75rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.proto{display:inline-block;font-family:var(--mono);font-size:.72rem;letter-spacing:.06em;text-transform:uppercase;border:1px solid var(--line);border-radius:4px;padding:2px 8px;color:var(--muted);margin-bottom:14px}
header{display:grid;gap:4px;margin-bottom:28px}
.grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:24px;align-items:start}
@media (max-width:900px){.grid{grid-template-columns:1fr}}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:20px;display:grid;gap:18px;min-width:0}
.row-head{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap}
.note{font-size:.82rem;color:var(--muted)}
.example{font-family:var(--mono);font-size:.72rem;color:var(--muted);background:var(--tint);padding:2px 8px;border-radius:4px}
label{font-size:.8rem;color:var(--muted);display:block;margin-bottom:4px}
select,input[type=number]{font:inherit;color:var(--fg);background:var(--bg);border:1px solid var(--line);border-radius:6px;padding:7px 9px;width:100%;min-width:0}
input[type=number]{font-family:var(--mono)}
select:focus-visible,input:focus-visible,button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.usage{display:grid;gap:10px}
.u-row{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1.2fr) 88px 32px;gap:8px;align-items:end;padding-bottom:10px;border-bottom:1px dashed var(--line)}
.u-row .per{grid-column:1/-1;font-family:var(--mono);font-size:.74rem;color:var(--muted)}
@media (max-width:520px){.u-row{grid-template-columns:minmax(0,1fr) 80px 32px}.u-row .mode{grid-column:1/-1;grid-row:2}.u-row .per{grid-row:3}}
button{font:inherit;cursor:pointer}
.del{border:1px solid var(--line);background:transparent;color:var(--muted);border-radius:6px;height:36px;width:32px;font-size:1.1rem;line-height:1}
.del:hover{color:var(--fg);border-color:var(--muted)}
.add{justify-self:start;border:1px solid var(--accent);background:transparent;color:var(--accent);border-radius:6px;padding:7px 14px;font-weight:500}
.add:hover{background:var(--tint)}
.settings{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
@media (max-width:520px){.settings{grid-template-columns:1fr 1fr}}
.toggle{display:flex;gap:8px;align-items:center;font-size:.85rem;color:var(--fg)}
.toggle input{accent-color:var(--water);width:16px;height:16px}

.readings{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:var(--line);border:1px solid var(--line);border-radius:10px;overflow:hidden}
.reading{background:var(--surface);padding:16px 18px;display:grid;gap:2px;align-content:start}
.reading .k{font-family:var(--mono);font-size:.72rem;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.reading .v{font-family:var(--display);font-size:clamp(1.6rem,3.4vw,2.2rem);font-weight:700;font-variant-numeric:tabular-nums;line-height:1.1}
.reading .r{font-family:var(--mono);font-size:.74rem;color:var(--muted);font-variant-numeric:tabular-nums}
.reading.co2 .v{color:var(--carbon)} .reading.tree .v{color:var(--leaf)} .reading.water .v,.reading.bottle .v{color:var(--water)}
.glyphs{display:flex;flex-wrap:wrap;gap:3px;min-height:20px}
.glyphs svg{width:13px;height:16px;flex:none}
.scale{font-family:var(--mono);font-size:.72rem;color:var(--muted)}
.bars{display:grid;gap:10px}
.bar{display:grid;grid-template-columns:minmax(0,9rem) minmax(0,1fr) 5.5rem;gap:10px;align-items:center;font-size:.85rem}
.bar .name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.track{position:relative;height:14px;background:var(--tint);border-radius:3px}
.track .fill{position:absolute;left:0;top:0;bottom:0;background:var(--carbon);border-radius:3px;opacity:.85}
.track .whisk{position:absolute;top:50%;height:2px;background:var(--muted);transform:translateY(-50%)}
.track .whisk::before,.track .whisk::after{content:"";position:absolute;top:-4px;width:2px;height:10px;background:var(--muted)}
.track .whisk::before{left:0}.track .whisk::after{right:0}
.bar .val{font-family:var(--mono);font-size:.78rem;text-align:right;font-variant-numeric:tabular-nums}
.levers{display:grid;gap:8px;margin:0;padding:0;list-style:none}
.levers li{padding-left:14px;border-left:2px solid var(--leaf);font-size:.88rem}
.method{margin-top:28px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
@media (max-width:900px){.method{grid-template-columns:1fr}}
.method p,.method li{font-size:.86rem;color:var(--muted);max-width:62ch}
.method ul{padding-left:18px;margin:6px 0}
.tablewrap{overflow-x:auto}
table{border-collapse:collapse;font-size:.8rem;width:100%;font-variant-numeric:tabular-nums}
th,td{text-align:left;padding:5px 8px;border-bottom:1px solid var(--line);white-space:nowrap}
th{font-family:var(--mono);font-weight:500;font-size:.7rem;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)}
td{font-family:var(--mono)}
a{color:var(--water)}
.chip{font-family:var(--mono);font-size:.66rem;letter-spacing:.05em;text-transform:uppercase;padding:1px 6px;border-radius:3px;border:1px solid var(--line);margin-left:6px;vertical-align:1px}
.chip.disc{color:var(--leaf);border-color:var(--leaf)}
.chip.est{color:var(--muted)}
.published{margin-top:28px}
.published td{white-space:normal;min-width:7rem}
.published td:first-child{font-family:var(--body);font-weight:500}
.published td:last-child{font-family:var(--body);color:var(--muted);min-width:16rem}
@media (prefers-reduced-motion:no-preference){.track .fill{transition:width .3s ease}}
</style>

</head>
<body>
<div class="wrap">
<header>
  <span class="proto">Prototype · Phase 1 estimator</span>
  <h1>Prompt Footprint</h1>
  <p class="lede">Estimate the carbon and water cost of your generative AI use, then see it as trees needed to absorb the CO₂ each year and 500 mL bottles of water used to cool and power the data centres. Every figure is a range, because providers disclose very little.</p>
</header>

<div class="grid">
  <section class="panel" aria-labelledby="usage-h">
    <div class="row-head">
      <h2 id="usage-h">Your usage</h2>
      <span class="example">Example: a 25-person team</span>
    </div>
    <div class="usage" id="usage"></div>
    <button class="add" id="add" type="button">Add a tool</button>

    <div class="settings">
      <div><label for="users">People using it</label><input id="users" type="number" min="1" value="25"></div>
      <div><label for="days">Days used per year</label><input id="days" type="number" min="1" max="366" value="220"></div>
      <div><label for="region">Where it is served</label>
        <select id="region">
          <option value="global">World average (458 g/kWh)</option>
          <option value="us" selected>United States (384 g/kWh)</option>
          <option value="ie">Ireland (257 g/kWh)</option>
          <option value="nl">Netherlands (254 g/kWh)</option>
          <option value="uk">United Kingdom (217 g/kWh)</option>
          <option value="nordic">Nordics (59 g/kWh)</option>
        </select></div>
    </div>
    <div class="settings">
      <div style="grid-column:span 2"><label for="tree">Trees counted as</label>
        <select id="tree">
          <option value="10" selected>Newly planted (about 10 kg CO₂ a year)</option>
          <option value="22">Mature (about 22 kg CO₂ a year)</option>
        </select></div>
    </div>
    <label class="toggle"><input id="offsite" type="checkbox"> Add water used in power stations (off-site, about 3.1 L per kWh)</label>
    <p class="note">Providers rarely say which data centre serves a prompt. United States is the default because most frontier model capacity is there. Grid figures are 2025 averages counting every source, so they run higher than the figures companies report after buying renewable energy.</p>
  </section>

  <section class="panel" aria-labelledby="out-h">
    <div class="row-head"><h2 id="out-h">Per year</h2><span class="note">Central estimate, with low to high range</span></div>
    <div class="readings">
      <div class="reading co2"><span class="k">CO₂e emitted</span><span class="v" id="o-co2">0</span><span class="r" id="o-co2r"></span></div>
      <div class="reading"><span class="k">Electricity</span><span class="v" id="o-kwh">0</span><span class="r" id="o-kwhr"></span></div>
      <div class="reading tree"><span class="k">Trees to absorb it</span><span class="v" id="o-tree">0</span><span class="r" id="o-treer"></span></div>
      <div class="reading bottle"><span class="k">500 mL bottles of water</span><span class="v" id="o-bot">0</span><span class="r" id="o-botr"></span></div>
    </div>
    <div>
      <div class="glyphs" id="g-tree" aria-hidden="true"></div>
      <div class="scale" id="g-tree-s"></div>
    </div>
    <div>
      <div class="glyphs" id="g-bot" aria-hidden="true"></div>
      <div class="scale" id="g-bot-s"></div>
    </div>
    <div>
      <div class="row-head" style="margin-bottom:10px"><h3>CO₂e by tool</h3><span class="note">bar = central, whiskers = range</span></div>
      <div class="bars" id="bars"></div>
    </div>
    <div>
      <h3 style="margin-bottom:8px">What actually reduces it</h3>
      <ul class="levers">
        <li>Use a smaller or faster model for routine tasks. Reasoning modes can use several times the energy, sometimes twenty times or more.</li>
        <li>Write one clear prompt instead of regenerating several times.</li>
        <li>Generate images and video only when they are needed. One 5-second video clip can use as much energy as thousands of text prompts.</li>
        <li>Planting trees absorbs carbon slowly and does nothing for water. Treat it as a way to grasp the scale, not as a fix.</li>
      </ul>
    </div>
  </section>
</div>

<section class="method" aria-label="Method">
  <div>
    <h2 style="margin-bottom:8px">How it is calculated</h2>
    <p>Energy per prompt (whole data centre, including idle servers and cooling overhead, as in Google's method) × prompt type gives electricity. Electricity × grid carbon intensity gives CO₂e. Water is on-site cooling at a water usage effectiveness (WUE) in litres per kWh, plus off-site power station water if switched on.</p>
    <p>Trees = CO₂e ÷ annual uptake of one tree. Newly planted trees take up about 10 kg a year over their first 20 years; a mature tree about 22 kg. Bottles = litres ÷ 0.5.</p>
    <p>Low and high combine the most and least favourable assumptions. Training, hardware manufacture and your own device are excluded; this covers use only.</p>
  </div>
  <div>
    <h2 style="margin-bottom:8px">Assumptions</h2>
    <div class="tablewrap"><table>
      <thead><tr><th>Factor</th><th>Low</th><th>Central</th><th>High</th></tr></thead>
      <tbody>
        <tr><td>On-site water L/kWh</td><td>0.2</td><td>1.0</td><td>1.9</td></tr>
        <tr><td>Long answer or input</td><td>×2</td><td>×3</td><td>×8</td></tr>
        <tr><td>Reasoning mode</td><td>×2.5</td><td>×5</td><td>×20</td></tr>
      </tbody>
    </table></div>
    <div class="tablewrap" style="margin-top:12px"><table id="tooltable">
      <thead><tr><th>Tool</th><th>Unit</th><th>Wh low</th><th>central</th><th>high</th></tr></thead><tbody></tbody>
    </table></div>
  </div>
  <div>
    <h2 style="margin-bottom:8px">Where the numbers come from</h2>
    <ul>
      <li>Text tools: Google's and OpenAI's own figures, Epoch AI's estimate for GPT-4o, and MIT Technology Review's measurements of open models as the upper bound.</li>
      <li>Long and reasoning multipliers: Epoch AI found long inputs raise energy several-fold, and reasoning models produced about 2.5 times the output tokens. The upper values are cautious estimates.</li>
      <li>Images and video: MIT Technology Review and <a href="https://arxiv.org/abs/2311.16863" target="_blank" rel="noopener">Luccioni et al.</a>. Commercial image and video models are undisclosed and probably larger.</li>
      <li>Water: Google uses 1.15 L/kWh; OpenAI's figures imply about 0.9. Off-site water follows <a href="https://arxiv.org/abs/2304.03271" target="_blank" rel="noopener">Li et al.</a> (US average).</li>
      <li>Grids: <a href="https://ourworldindata.org/grapher/carbon-intensity-electricity" target="_blank" rel="noopener">Our World in Data / Ember</a>, 2025. The UK operator NESO reports a lower 129 g/kWh because it counts biomass as zero carbon.</li>
      <li>Trees: European Environment Agency (mature) and One Tree Planted (young).</li>
    </ul>
    <p>Figures checked October 2026.</p>
  </div>
</section>

<section class="published panel" aria-labelledby="pub-h">
  <div class="row-head"><h2 id="pub-h">Published per-prompt figures</h2><span class="note">Why estimates differ so much</span></div>
  <div class="tablewrap"><table>
    <thead><tr><th>Source</th><th>Energy</th><th>CO₂e</th><th>Water</th><th>What it counts</th></tr></thead>
    <tbody>
      <tr><td>Google, Gemini text prompt (Aug 2025)</td><td>0.24 Wh</td><td>0.03 g</td><td>0.26 mL</td><td>Median prompt. Includes idle servers and cooling. Carbon is after renewable purchases (94 g/kWh), not the local grid. Counting only the AI chips gives 0.10 Wh.</td></tr>
      <tr><td>OpenAI, ChatGPT query (Jun 2025)</td><td>0.34 Wh</td><td>not given</td><td>0.32 mL</td><td>Average query. Method not published.</td></tr>
      <tr><td>Epoch AI, GPT-4o (Feb 2025)</td><td>0.3 Wh</td><td>not given</td><td>not given</td><td>Independent estimate. Rises to about 2.5 Wh with a 10,000-token input.</td></tr>
      <tr><td>Mistral, Le Chat response (Jul 2025)</td><td>not given</td><td>1.14 g</td><td>45 mL</td><td>Full lifecycle, including manufacturing the hardware. Much wider boundary, so much higher.</td></tr>
      <tr><td>MIT Technology Review (May 2025)</td><td>0.03 to 1.9 Wh</td><td>not given</td><td>not given</td><td>Open models measured directly: small to very large text model. Image 0.63 Wh; 5-second video about 944 Wh.</td></tr>
    </tbody>
  </table></div>
  <p class="note">Each company draws the boundary differently. That is the main reason the same question gets answers 40 times apart, and a good discussion point for students.</p>
</section>
</div>

<script>
// wh = whole-system Wh per unit [low, central, high]; src: disclosed by provider or estimated
const TOOLS={
  chatgpt:{name:"ChatGPT",kind:"text",wh:[0.3,0.34,1.9],src:"disc"},
  gemini:{name:"Gemini",kind:"text",wh:[0.10,0.24,1.0],src:"disc"},
  claude:{name:"Claude",kind:"text",wh:[0.2,0.4,1.9],src:"est"},
  copilot:{name:"Microsoft Copilot",kind:"text",wh:[0.3,0.4,1.9],src:"est"},
  perplexity:{name:"Perplexity",kind:"text",wh:[0.3,0.5,2.0],src:"est"},
  midjourney:{name:"Midjourney",kind:"image",wh:[0.6,2,6],src:"est"},
  chatimg:{name:"ChatGPT images",kind:"image",wh:[0.6,2,6],src:"est"},
  video:{name:"Video (Sora, Veo)",kind:"video",wh:[300,944,2000],src:"est"}
};
const MODES={short:{n:"Typical prompt",m:[1,1,1]},long:{n:"Long answer or document",m:[2,3,8]},reason:{n:"Reasoning mode",m:[2.5,5,20]}};
const UNIT={text:"per prompt",image:"per image",video:"per 5 s clip"};
const GRID={global:0.458,us:0.384,ie:0.257,nl:0.254,uk:0.217,nordic:0.059}; // kg CO2e per kWh, OWID/Ember 2025
const WUE=[0.2,1.0,1.9], OFF=3.1; // L per kWh

let rows=[
  {tool:"chatgpt",mode:"long",n:20},
  {tool:"copilot",mode:"short",n:10},
  {tool:"claude",mode:"reason",n:5},
  {tool:"gemini",mode:"short",n:5},
  {tool:"midjourney",mode:"short",n:2}
];
const $=id=>document.getElementById(id);

function fmt(x){
  if(!isFinite(x))return"0";
  const a=Math.abs(x);
  if(a===0)return"0";
  if(a>=100)return Math.round(x).toLocaleString("en-GB");
  if(a>=10)return x.toFixed(1);
  if(a>=1)return x.toFixed(2);
  return Number(x.toPrecision(2)).toString();
}
function mass(kg){return kg>=1000?fmt(kg/1000)+" t":fmt(kg)+" kg"}
function massG(g){return g>=1000?fmt(g/1000)+" kg":fmt(g)+" g"}

function perUnit(r){
  const t=TOOLS[r.tool],m=t.kind==="text"?MODES[r.mode].m:[1,1,1];
  const off=$("offsite").checked, ci=GRID[$("region").value];
  return [0,1,2].map(i=>{
    const wh=t.wh[i]*m[i];
    return {wh,g:wh*ci,ml:wh*WUE[i]+(off?wh*OFF:0)};
  });
}

function renderRows(){
  const box=$("usage");box.innerHTML="";
  rows.forEach((r,idx)=>{
    const t=TOOLS[r.tool];
    const el=document.createElement("div");el.className="u-row";
    const toolOpts=Object.entries(TOOLS).map(([k,v])=>`<option value="${k}"${k===r.tool?" selected":""}>${v.name}</option>`).join("");
    const modeOpts=t.kind==="text"?Object.entries(MODES).map(([k,v])=>`<option value="${k}"${k===r.mode?" selected":""}>${v.n}</option>`).join(""):`<option>${t.kind==="image"?"Image":"Short clip"}</option>`;
    el.innerHTML=`
      <div><label for="t${idx}">Tool<span class="chip ${t.src}">${t.src==="disc"?"Disclosed":"Estimated"}</span></label><select id="t${idx}">${toolOpts}</select></div>
      <div class="mode"><label for="m${idx}">Typical use</label><select id="m${idx}"${t.kind!=="text"?" disabled":""}>${modeOpts}</select></div>
      <div><label for="n${idx}">${t.kind==="text"?"Prompts":t.kind==="image"?"Images":"Clips"}/day</label><input id="n${idx}" type="number" min="0" step="1" value="${r.n}"></div>
      <button class="del" type="button" aria-label="Remove ${t.name}">×</button>
      <div class="per" id="p${idx}"></div>`;
    el.querySelector(`#t${idx}`).onchange=e=>{r.tool=e.target.value;renderRows();calc()};
    el.querySelector(`#m${idx}`).onchange=e=>{r.mode=e.target.value;calc()};
    el.querySelector(`#n${idx}`).oninput=e=>{r.n=Math.max(0,+e.target.value||0);calc()};
    el.querySelector(".del").onclick=()=>{rows.splice(idx,1);renderRows();calc()};
    box.appendChild(el);
  });
}

const TREE_SVG='<svg viewBox="0 0 13 16"><path d="M6.5 1 1.5 9h3L2 12.5h9L8.5 9h3z" fill="var(--leaf)"/><rect x="5.6" y="12.5" width="1.8" height="3" fill="var(--leaf)"/></svg>';
const BOT_SVG='<svg viewBox="0 0 13 16"><rect x="5" y="0.5" width="3" height="2" rx=".5" fill="var(--water)"/><path d="M4.5 3h4l1.5 2.5V15a.8.8 0 0 1-.8.8H3.8A.8.8 0 0 1 3 15V5.5z" fill="var(--water)"/></svg>';
function glyphs(id,count,svg,word){
  const box=$(id),s=$(id+"-s");
  const steps=[1,2,5,10,20,50,100,200,500,1000,2000,5000,10000,20000,50000,100000,1e6];
  const unit=steps.find(u=>count/u<=80)||1e7;
  const n=Math.max(count>0?1:0,Math.round(count/unit));
  box.innerHTML=svg.repeat(Math.min(n,80));
  s.textContent=`Each icon = ${unit.toLocaleString("en-GB")} ${word}${unit>1?"s":""}`;
}

function calc(){
  const users=Math.max(1,+$("users").value||1), days=Math.max(1,+$("days").value||1);
  const tot=[0,1,2].map(()=>({kwh:0,kg:0,l:0}));
  const per=[];
  rows.forEach((r,idx)=>{
    const u=perUnit(r), vol=r.n*users*days;
    const p=$("p"+idx);
    if(p)p.textContent=`${UNIT[TOOLS[r.tool].kind]}: ${fmt(u[1].wh)} Wh · ${massG(u[1].g)} CO₂e · ${fmt(u[1].ml)} mL water`;
    const kg=u.map(x=>x.g*vol/1000);
    per.push({name:TOOLS[r.tool].name,kg});
    u.forEach((x,i)=>{tot[i].kwh+=x.wh*vol/1000;tot[i].kg+=x.g*vol/1000;tot[i].l+=x.ml*vol/1000});
  });
  const uptake=+$("tree").value;
  const trees=tot.map(t=>t.kg/uptake), bottles=tot.map(t=>t.l/0.5);
  $("o-co2").textContent=mass(tot[1].kg);$("o-co2r").textContent=`${mass(tot[0].kg)} to ${mass(tot[2].kg)}`;
  $("o-kwh").textContent=fmt(tot[1].kwh)+" kWh";$("o-kwhr").textContent=`${fmt(tot[0].kwh)} to ${fmt(tot[2].kwh)} kWh`;
  $("o-tree").textContent=fmt(trees[1]);$("o-treer").textContent=`${fmt(trees[0])} to ${fmt(trees[2])} trees`;
  $("o-bot").textContent=fmt(bottles[1]);$("o-botr").textContent=`${fmt(bottles[0])} to ${fmt(bottles[2])} bottles · ${fmt(tot[1].l)} L`;
  glyphs("g-tree",trees[1],TREE_SVG,"tree");
  glyphs("g-bot",bottles[1],BOT_SVG,"bottle");
  const max=Math.max(...per.map(p=>p.kg[2]),1e-9);
  $("bars").innerHTML=per.map(p=>`<div class="bar"><span class="name" title="${p.name}">${p.name}</span>
    <div class="track"><div class="fill" style="width:${p.kg[1]/max*100}%"></div><div class="whisk" style="left:${p.kg[0]/max*100}%;width:${(p.kg[2]-p.kg[0])/max*100}%"></div></div>
    <span class="val">${mass(p.kg[1])}</span></div>`).join("")||'<p class="note">Add a tool to see the breakdown.</p>';
}

$("tooltable").querySelector("tbody").innerHTML=Object.values(TOOLS).map(t=>`<tr><td>${t.name}</td><td>${UNIT[t.kind].replace("per ","")}</td><td>${t.wh[0]}</td><td>${t.wh[1]}</td><td>${t.wh[2]}</td></tr>`).join("");
$("add").onclick=()=>{rows.push({tool:"chatgpt",mode:"short",n:5});renderRows();calc()};
["users","days"].forEach(id=>$(id).oninput=calc);
["region","offsite","tree"].forEach(id=>$(id).onchange=calc);
renderRows();calc();
</script>

</body>
</html>
